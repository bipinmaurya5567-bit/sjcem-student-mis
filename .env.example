# ========================================================================
# SJCEM NEXT MIS — Environment Configuration Template
# Institution: St. John College of Engineering and Management, Palghar
# Trust: ALDEL Education Trust
# ========================================================================

# 1. SUPABASE DATABASE CONFIGURATION (SERVER-SIDE ONLY)
# Never expose the service-role key in frontend browser code.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-side-secret-service-role-key-do-not-expose

# 2. INSTITUTIONAL STUDENT RETRIEVAL INTEGRATION (SERVER-SIDE ONLY)
# Options: 'LOCAL_IMPORTED' (approved local DB via CSV/Excel) or 'AUTHORIZED_API' (official server-to-server)
VITE_STUDENT_INTEGRATION_MODE=LOCAL_IMPORTED

# Server-Side Official College API Gateway (Required only when Mode is 'AUTHORIZED_API')
# NEVER prefix confidential keys with VITE_ to keep them strictly isolated to the server.
# Contact St. John Technical Campus Network Cell / Registrar for official credentials.
INSTITUTIONAL_API_URL=https://api.aldel.org/v1/students
INSTITUTIONAL_API_KEY=your-authorized-college-api-key-here
INSTITUTIONAL_API_CLIENT_ID=sjcem-mis-production-client
INSTITUTIONAL_API_AUTH_TYPE=Bearer
INSTITUTIONAL_API_TIMEOUT_MS=5000

# Development/QA Testing Mode:
# When set to 'true', enables simulated mock responses for unit testing the server adapter
# flow without claiming live connection to college servers. Set to 'false' in production.
ENABLE_MOCK_INSTITUTIONAL_GATEWAY=false

# 3. RATE LIMITING & SECURITY THRESHOLDS
LOOKUP_RATE_LIMIT_PER_MINUTE=20
LOOKUP_BURST_ALLOWANCE=5
SESSION_EXPIRY_MINUTES=480

# 4. APPLICATION RUNTIME
VITE_APP_ENV=development
VITE_APP_VERSION=2.4.0
VITE_CAMPUS_CODE=SJCEM-PALGHAR
